<group name="storylab,">
  <rule id="100100" level="0">
    <decoded_as>json</decoded_as>
    <field name="integration">^storylab$</field>
    <description>StoryLab normalized demonstration event</description>
  </rule>
  <rule id="100101" level="5">
    <if_sid>100100</if_sid><field name="event">^auth_failure$</field>
    <description>StoryLab failed authentication</description><group>authentication_failed,</group>
  </rule>
  <rule id="100102" level="3">
    <if_sid>100100</if_sid><field name="event">^auth_success$</field>
    <description>StoryLab successful authentication</description><group>authentication_success,</group>
  </rule>
  <rule id="100103" level="10">
    <if_sid>100100</if_sid><field name="event">^admin_group_change$</field>
    <description>StoryLab privileged group change for review</description>
  </rule>
  <rule id="100104" level="7">
    <if_sid>100100</if_sid><field name="event">^file_change$</field>
    <description>StoryLab monitored file change</description>
  </rule>
  <rule id="100105" level="3">
    <if_sid>100100</if_sid><field name="event">^process$</field>
    <description>StoryLab process context</description>
  </rule>
</group>
